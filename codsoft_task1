import tkinter as tk
tasks = []
def add_task():
    task = entry.get()
    if task:
        tasks.append(task)
        entry.delete(0, tk.END)
        show_tasks()
def select_task(event):
    selected = listbox.curselection()
    if selected:
        entry.delete(0, tk.END)
        entry.insert(0, tasks[selected[0]])
def update_task():
    selected = listbox.curselection()
    if selected and entry.get():
        tasks[selected[0]] = entry.get()
        entry.delete(0, tk.END)
        show_tasks()
def delete_task():
    selected = listbox.curselection()
    if selected:
        tasks.pop(selected[0])
        show_tasks()

def show_tasks():
    listbox.delete(0, tk.END)
    for i, task in enumerate(tasks, 1):
        listbox.insert(tk.END, f"{i}. {task}")
root = tk.Tk()
root.title("To-Do List")
root.geometry("400x400")

tk.Label(root, text="To-Do List",font=("Arial", 20, "bold")).pack(pady=15)
entry = tk.Entry(root, width=35)
entry.pack(pady=10)
tk.Button(root, text="Add", command=add_task).pack(pady=5)
tk.Button(root, text="Update", command=update_task).pack(pady=5)
tk.Button(root, text="Delete", command=delete_task).pack(pady=5)
listbox = tk.Listbox(root, width=40, height=12)
listbox.pack(pady=15)
listbox.bind("<<ListboxSelect>>", select_task)
root.mainloop()
